# Copy to .env.local and fill in. Everything is optional for local dev —
# without Supabase the site uses a local file store (.data/db.json).

# --- Admin panel (required to use /admin) ---
ADMIN_PASSWORD=
# Optional separate cookie-signing secret (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# MFA (recommended): generate with `node scripts/generate-totp-secret.mjs`,
# scan the printed otpauth:// URL into Google Authenticator / Authy.
# When set, login requires password + 6-digit code.
ADMIN_TOTP_SECRET=

# --- Supabase (production database; run supabase/schema.sql first) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (lead alerts + the secretary bot) ---
# 1. Create a bot with @BotFather → token below.
# 2. Send /start to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
# 3. Admin chat IDs — comma-separated; ONLY these accounts can talk to the
#    secretary. (TELEGRAM_CHAT_ID still works as a single-admin fallback.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
# Shared secret proving webhook calls come from Telegram (any random string;
# also used by scripts/telegram-poll.mjs in local dev).
TELEGRAM_WEBHOOK_SECRET=

# --- Email via Resend (lead alerts + quote emails from the secretary) ---
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- AI representative ---
# Provider + model are picked in /admin/settings; a key here enables that
# provider in the picker. At least one key is required for the chat.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Global daily cap on visitor chat messages (spend cap; default 400)
AI_DAILY_LIMIT=

# --- Public site URL (used by sitemap.xml / robots.txt) ---
SITE_URL=

# --- Cron protection (required in production) ---
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
